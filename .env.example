# FHIR Server base_url now lives in configs/connectors/internal.yaml —
# override it per-environment with CONNECTORS__INTERNAL__BASE_URL
# instead of setting it here.

# Terminology service on the FHIR Server (separate base path from the
# internal connector's base_url above)
TERMINOLOGY_SERVER_URL=http://localhost:8000/api/v1/terminology

# Medplum connector (oauth_client_credentials) — only read when
# connectors.active: medplum. Get these from Medplum's Project Admin ->
# Clients page. Never put real values in configs/connectors/medplum.yaml.
# CONNECTORS__MEDPLUM__CLIENT_ID=
# CONNECTORS__MEDPLUM__CLIENT_SECRET=

# BetterAuth / IAM
IAM_JWKS_URL=http://localhost:3000/api/auth/jwks
IAM_ISSUER=http://localhost:3000

# App
ENVIRONMENT=development

# Redis connection string — only used while configs/config.yaml's redis.enabled
# is true (the default). CORS origins and rate limits now live in
# configs/config.yaml, not here — see that file.
REDIS_URL=redis://localhost:6379/0
