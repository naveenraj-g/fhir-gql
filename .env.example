# FHIR Server base_url now lives in configs/connectors/internal.yaml —
# override it per-environment with CONNECTORS__INTERNAL__BASE_URL
# instead of setting it here.

# Terminology service on the FHIR Server (separate base path from the
# internal connector's base_url above)
TERMINOLOGY_SERVER_URL=http://localhost:8000/api/v1/terminology

# Medplum connector (oauth_client_credentials) — only read when
# connectors.active: medplum. Get these from Medplum's Project Admin ->
# Clients page. Never put real values in configs/connectors/medplum.yaml.
# CONNECTORS__MEDPLUM__CLIENT_ID=
# CONNECTORS__MEDPLUM__CLIENT_SECRET=

# OpenEMR connector (OAuth2 client credentials with system scopes, signed-JWT
# client login) - only read when connectors.active: openemr.
# Setup on the OpenEMR side (Administration -> Config -> Connectors): turn on
# Standard REST API, Standard FHIR REST API and FHIR System Scopes, and set
# Site Address Override to exactly http://localhost (no trailing dot). Then
# register the client (Administration -> System -> API Clients -> Register New
# App) with the public JWKS inline, and enable it in the API Clients list.
# The gateway signs its login JWT (RS384) with the matching PRIVATE key; the
# client secret OpenEMR also issues is not used for system scopes. Never put
# real values in configs/connectors/openemr.yaml.
# CONNECTORS__OPENEMR__CLIENT_ID=
# Path to the private key (PEM), relative to the working directory. The
# secrets/ folder is gitignored.
# CONNECTORS__OPENEMR__PRIVATE_KEY_PATH=secrets/openemr_private_key.pem
#
# Optional per-environment overrides of the committed defaults (the local
# Docker OpenEMR in docker/connectors/openemr). Not secrets. The token URL is
# also the JWT audience, so it must equal OpenEMR's own token endpoint exactly.
# CONNECTORS__OPENEMR__BASE_URL=http://localhost/apis/default/fhir
# CONNECTORS__OPENEMR__TOKEN_URL=http://localhost/oauth2/default/token

# Epic on FHIR connector (read-only, SMART Backend Services signed-JWT login) -
# only read when connectors.active: epic. Register a "Backend Systems" app at
# fhir.epic.com (Organization/Location read, Organizational Directory) with the
# public JWKS hosted at a public HTTPS URL. Use the NON-PRODUCTION Client ID for
# the sandbox. The private key is under secrets/ (gitignored); never share it.
# CONNECTORS__EPIC__CLIENT_ID=
# CONNECTORS__EPIC__PRIVATE_KEY_PATH=secrets/epic_private_key.pem

# BetterAuth / IAM
IAM_JWKS_URL=http://localhost:3000/api/auth/jwks
IAM_ISSUER=http://localhost:3000

# App
ENVIRONMENT=development

# Redis connection string — only used while configs/config.yaml's redis.enabled
# is true (the default). CORS origins and rate limits now live in
# configs/config.yaml, not here — see that file.
REDIS_URL=redis://localhost:6379/0
